SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SyncPay credentials must exist only on the server.
SYNC_PAY_CLIENT_ID=
SYNC_PAY_CLIENT_SECRET=
SYNC_PAY_API_URL=https://api.syncpayments.com.br
SYNC_PAY_WEBHOOK_URL=https://your-domain.example/api/public/webhooks/syncpay

# Optional: configure only when the SyncPay account sends a fixed webhook
# bearer token. Even without it, every event is verified through the
# authenticated transaction-status endpoint before access is released.
SYNC_PAY_WEBHOOK_BEARER_TOKEN=

# ONPAY — API key and webhook secret can be managed in the admin panel.
# This 32-byte base64 key encrypts those credentials at rest and must remain
# stable across deployments. Generate once with: openssl rand -base64 32
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
ONPAY_API_URL=https://api.onpay.global
# Optional bootstrap/fallback values. Prefer the encrypted admin panel fields.
ONPAY_API_KEY=
ONPAY_WEBHOOK_SECRET=

# Meta Conversions API — server-side only. Never prefix these with VITE_.
META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_EVENT_SOURCE_URL=https://famaflix.online/

# Optional while validating events in Meta Events Manager. Remove in production.
META_TEST_EVENT_CODE=
